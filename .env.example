# Tazkia Mengajar Monitoring System — environment template
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
# Prisma's CLI reads `.env`, which is why local settings live there rather than
# in `.env.local`.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by the application at runtime.
# On Neon this must be the POOLED connection (its host contains "-pooler"),
# because serverless functions open many short-lived connections.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tazkia_mengajar?schema=public"

# Direct, non-pooled connection used only by `prisma migrate`.
# PgBouncer cannot run the DDL and advisory locks migrations need.
# Locally this is the same as DATABASE_URL; on Neon it is the endpoint WITHOUT
# "-pooler". If unset, DATABASE_URL is used instead.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tazkia_mengajar?schema=public"

# --- Authentication ---------------------------------------------------------
# Signing key for the session JWT. Must be at least 32 characters.
# Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this invalidates every existing session.
AUTH_SECRET=""

# --- Object storage ---------------------------------------------------------
# Vercel Blob read/write token, used to store documentation files.
# Create a Blob store in the Vercel dashboard (Storage -> Blob); connecting it
# to the project sets this automatically on deployments.
#
# REQUIRED in production — the app refuses to upload without it.
# Leave empty in local development to fall back to a `.uploads/` folder, which
# exercises the full pipeline (validation, WebP conversion, metadata, delete)
# without provisioning a store. That fallback is development-only because
# Vercel's filesystem is ephemeral and would lose files on every deploy.
BLOB_READ_WRITE_TOKEN=""

# --- Google Drive (Dokumentasi Kegiatan & Laporan Otomatis) -------------------
# ID folder induk di Google Drive tempat subfolder kegiatan akan otomatis dibuat.
# Dapatkan dari URL folder: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_PARENT_FOLDER_ID=""

# Opsi 1 (Direkomendasikan untuk Google Drive Pribadi / Gmail):
# OAuth 2.0 Client credentials & Refresh Token (jalankan `npm run auth:gdrive` untuk generate)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Opsi 2 (Untuk Google Workspace / Shared Drive organisasi):
# Kredensial Service Account Google Cloud.
# 2a: Taruh file JSON kunci service account di root project dengan nama `google-credentials.json`
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=""
# 2b: Atau isi langsung email dan private key service account:
# GOOGLE_SERVICE_ACCOUNT_EMAIL="tazkia-mengajar@tazkia-mengajar.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 2c: Atau isi seluruh konten file JSON sebagai string satu baris:
# GOOGLE_SERVICE_ACCOUNT_JSON=""

